---
import '../styles/global.css';
import { Image } from 'astro:assets';
import { base } from '../lib/base';
import appIcon from '../assets/app-icon.png';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '字面 Live — 专为主播与歌回打造的 OBS 实时动态歌词引擎',
  description = '字面 Live（JIZURA Live）是专为虚拟主播与音乐现场打造的 OBS 实时动态歌词渲染器：内置 27 套视觉风格，文字智能避让皮套立绘，显存直推 OBS 丝滑 60 帧，推流 CPU 零负担。支持酷狗与网易云曲库点播，纯本地离线运行。',
} = Astro.props;

const path = Astro.url.pathname;

// SEO：canonical 与社交卡片都用绝对地址（site 已在 astro.config 里配置）
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(`${base}og-cover.jpg`, Astro.site).href;
const siteName = '字面 Live';

const homeUrl = new URL(base, Astro.site).href;

// 首页给软件实体，文档页给面包屑 —— 同一套 SoftwareApplication 铺到每个页面
// 会让子页面的主题实体失真。
const SEGMENT_LABELS: Record<string, string> = { docs: '使用说明', ref: '开发者文档' };
const segments = path.slice(base.length).replace(/\/$/, '').split('/').filter(Boolean);

const softwareApplication = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: '字面 Live',
  alternateName: 'JIZURA Live',
  applicationCategory: 'MultimediaApplication',
  applicationSubCategory: '直播歌词渲染器',
  operatingSystem: 'Windows 10, Windows 11',
  description,
  url: canonical,
  downloadUrl: 'https://github.com/GaoXanSheng/JIZURA-Live/releases/latest',
  screenshot: ogImage,
  inLanguage: 'zh-Hans',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
  author: {
    '@type': 'Organization',
    name: 'JIZURA Live',
    url: 'https://github.com/GaoXanSheng/JIZURA-Live',
  },
};

const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '字面 Live',
  alternateName: 'JIZURA Live',
  url: homeUrl,
  inLanguage: 'zh-Hans',
};

let structuredData: Record<string, unknown>[];
if (segments.length === 0) {
  structuredData = [softwareApplication, webSite];
} else {
  const crumbs = [{ name: '首页', url: homeUrl }];
  let acc = base;
  for (const [i, seg] of segments.entries()) {
    acc += `${seg}/`;
    const isLast = i === segments.length - 1;
    crumbs.push({
      name: isLast ? title.replace(/\s*—\s*字面 Live$/, '') : (SEGMENT_LABELS[seg] ?? seg),
      url: new URL(acc, Astro.site).href,
    });
  }
  structuredData = [
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
  ];
}

const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');

const nav = [
  { href: `${base}docs/getting-started/`, label: '快速上手' },
  { href: `${base}docs/spout/`, label: '推流配置' },
  { href: `${base}docs/features/`, label: '27 套风格', secondary: true },
  { href: `${base}docs/`, label: '全部文档', secondary: true },
];

const isCurrent = (href: string) => path.replace(/\/$/, '') === href.replace(/\/$/, '');
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="字面 Live 实时动态歌词渲染效果" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0c0e14" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <script type="application/ld+json" is:inline set:html={structuredDataJson} />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap wrap--wide site-head__row">
        <a class="brand" href={base}>
          <Image src={appIcon} alt="" width={64} height={64} class="brand__logo" />
          <span class="brand__name">字面 Live</span>
          <span class="brand__badge">歌回推流引擎</span>
        </a>
        <nav class="site-nav">
          {nav.map((item) => (
            <a
              href={item.href}
              class={item.secondary ? 'site-nav__secondary' : undefined}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          <a
            href="https://github.com/GaoXanSheng/JIZURA-Live"
            target="_blank"
            rel="noopener noreferrer"
            class="site-nav__gh"
          >
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap wrap--wide">
        <div class="site-foot__row">
          <div class="site-foot__brand">
            字面 Live (JIZURA Live) · 免费提供 · 专为歌回与主播定制
          </div>
          <div class="site-foot__links">
            <a href="https://qm.qq.com/q/JiJpxIrxuM" target="_blank" rel="noopener noreferrer">QQ 交流群</a>
            <span aria-hidden="true">·</span>
            <a href="https://github.com/GaoXanSheng/JIZURA-Live" target="_blank" rel="noopener noreferrer">GitHub</a>
            <span aria-hidden="true">·</span>
            <a href={`${base}docs/privacy/`}>隐私与许可</a>
            <span aria-hidden="true">·</span>
            <a href={`${base}docs/ref/mcp/`}>开发者 MCP</a>
          </div>
        </div>
        <p class="site-foot__legal">
          工具本体基于 852wa/JIZURA 深度定制。用本工具制作的视频、动效及直播画面（输出物）版权归创作者所有；所使用的歌词与音乐伴奏版权归各自权利人所有。
        </p>
      </div>
    </footer>

    <dialog class="lightbox" aria-label="放大查看图片">
      <img alt="" />
    </dialog>

    <script>
      // 正文与界面截图点击放大：原生 <dialog>，自带遮罩与 Esc 关闭
      const dlg = document.querySelector('.lightbox');
      const big = dlg && dlg.querySelector('img');
      if (dlg && big) {
        for (const el of document.querySelectorAll('.prose img, .shot-frame img')) {
          el.classList.add('zoomable');
          el.tabIndex = 0;
          el.setAttribute('role', 'button');
          el.setAttribute('aria-label', `放大查看：${el.alt || '图片'}`);
          const open = () => {
            big.src = el.currentSrc || el.src;
            big.alt = el.alt;
            dlg.showModal();
          };
          el.addEventListener('click', open);
          el.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              open();
            }
          });
        }
        // 点画面任意处（含图片本身）关闭
        dlg.addEventListener('click', () => dlg.close());
      }

      // 目录里点条目后收起面板，免得挡住刚跳到的内容
      for (const a of document.querySelectorAll('.toc__panel a')) {
        a.addEventListener('click', () => a.closest('details').removeAttribute('open'));
      }
    </script>
  </body>
</html>
